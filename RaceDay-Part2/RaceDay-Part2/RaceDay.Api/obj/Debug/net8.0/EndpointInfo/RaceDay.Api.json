          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "registrationDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "distanceKm": {
            "type": "number",
            "format": "double"
          },
          "eventType": {
            "type": "string",
