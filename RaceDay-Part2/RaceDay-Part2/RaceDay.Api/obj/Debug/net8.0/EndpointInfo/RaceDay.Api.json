  "components": {
    "schemas": {
      "Category": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "eventCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventCategory"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Enrolment": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "enrolmentId": {
            "type": "integer",
            "format": "int32"
          },
          "participantId": {
            "type": "integer",
            "format": "int32"
