          "email": {
            "maxLength": 180,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "passwordHash": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 30,
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "organisedEvents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "nullable": true
          },
          "enrolments": {
            "type": "array",
            "items": {
