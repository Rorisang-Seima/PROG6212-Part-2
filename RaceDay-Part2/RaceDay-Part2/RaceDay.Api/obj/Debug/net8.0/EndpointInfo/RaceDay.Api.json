            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Event": {
        "required": [
          "eventType",
          "location",
          "name"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "format": "int32"
          },
          "organiserId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "maxLength": 250,
            "minLength": 1,
            "type": "string"
          },
          "registrationDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "imageUrl": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "routeInfoUrl": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "distanceKm": {
            "maximum": 1000,
            "minimum": 0,1,
            "type": "number",
            "format": "double"
          },
          "eventType": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "organiser": {
            "$ref": "#/components/schemas/User"
          },
          "eventCategories": {
            "type": "array",
